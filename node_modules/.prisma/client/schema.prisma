datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CLIENT
  PROMOTER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum EventStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CLOSED
  CANCELLED
}

enum GroupStatus {
  ACTIVE
  CLOSED
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

model User {
  id           String     @id @default(uuid()) @map("_id")
  name         String
  email        String     @unique
  passwordHash String
  role         Role
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  clientProfile   Client?
  promoterProfile Promoter?
  groupMembers    GroupMember[]
  sentMessages    Message[]
  givenRatings    Rating[]      @relation("GivenRatings")
  receivedRatings Rating[]      @relation("ReceivedRatings")
}

model Client {
  id        String     @id @default(uuid()) @map("_id")
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   String
  phone     String
  notes     String?
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  events             Event[]
  clientGroupMembers ClientGroupMember[]
}

model ClientGroup {
  id          String   @id @default(uuid()) @map("_id")
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members ClientGroupMember[]
  events  Event[]
}

model ClientGroupMember {
  id            String      @id @default(uuid()) @map("_id")
  clientGroupId String
  clientGroup   ClientGroup @relation(fields: [clientGroupId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([clientGroupId, clientId])
}

model Promoter {
  id          String     @id @default(uuid()) @map("_id")
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoUrl    String?
  phone       String
  skills      String?
  experience  String?
  status      UserStatus @default(ACTIVE)
  rating      Float      @default(5.0)
  ratingCount Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  assignments EventPromoter[]
  checkIns    CheckIn[]
}

model Event {
  id                String       @id @default(uuid()) @map("_id")
  name              String
  clientId          String
  client            Client       @relation(fields: [clientId], references: [id])
  clientGroupId     String?
  clientGroup       ClientGroup? @relation(fields: [clientGroupId], references: [id])
  locationName      String
  address           String
  latitude          Float
  longitude         Float
  checkInRadius     Float        @default(200) // meters
  startDateTime     DateTime
  endDateTime       DateTime
  requiredPromoters Int          @default(1)
  description       String?
  dressCode         String?
  instructions      String?
  status            EventStatus  @default(SCHEDULED)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  assignedPromoters EventPromoter[]
  eventGroup        EventGroup?
  checkIns          CheckIn[]
  ratings           Rating[]
}

model EventPromoter {
  id         String   @id @default(uuid()) @map("_id")
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  promoterId String
  promoter   Promoter @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  status     String   @default("ASSIGNED")

  @@unique([eventId, promoterId])
}

model EventGroup {
  id        String      @id @default(uuid()) @map("_id")
  eventId   String      @unique
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status    GroupStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  closedAt  DateTime?

  members  GroupMember[]
  messages Message[]
}

model GroupMember {
  id       String     @id @default(uuid()) @map("_id")
  groupId  String
  group    EventGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role
  joinedAt DateTime   @default(now())

  @@unique([groupId, userId])
}

model Message {
  id          String      @id @default(uuid()) @map("_id")
  groupId     String
  group       EventGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId    String?
  sender      User?       @relation(fields: [senderId], references: [id], onDelete: SetNull)
  messageType MessageType @default(TEXT)
  content     String
  metadata    String?
  createdAt   DateTime    @default(now())
}

model CheckIn {
  id                String    @id @default(uuid()) @map("_id")
  eventId           String
  event             Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  promoterId        String
  promoter          Promoter  @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  checkInTime       DateTime  @default(now())
  checkInLatitude   Float
  checkInLongitude  Float
  checkOutTime      DateTime?
  checkOutLatitude  Float?
  checkOutLongitude Float?
  durationMinutes   Int?
}

model Rating {
  id         String   @id @default(uuid()) @map("_id")
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User     @relation("GivenRatings", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("ReceivedRatings", fields: [toUserId], references: [id], onDelete: Cascade)
  rating     Int
  feedback   String?
  categories String?
  createdAt  DateTime @default(now())
}
